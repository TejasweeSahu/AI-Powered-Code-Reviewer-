# Port for Express Server
PORT=3000

# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# Gemini Model (Optional, defaults to gemini-3.8-flash; can also use gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# Allowed CORS origins (Optional). Unset or * allows all origins.
# Otherwise a comma-separated list; entries may use * wildcards, e.g.
#   CLIENT_URL=https://my-app.vercel.app,https://my-app-*.vercel.app
# localhost is allowed automatically when NODE_ENV is not "production".
CLIENT_URL=*

# Rate limit for POST /ai/get-review, per client IP (Optional)
# Defaults: 20 requests per 15 minutes
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000
