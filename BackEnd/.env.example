# Port for Express Server
PORT=3000

# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# Gemini Model (Optional, defaults to gemini-3.8-flash; can also use gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Allowed CORS Origin (Optional: * allows all, or comma-separated URLs; *.vercel.app is allowed automatically)
CLIENT_URL=*


